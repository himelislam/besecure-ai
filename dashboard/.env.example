# Base URL of the backend API (server/) — no /api suffix; each endpoint path
# already includes its own /api (or /webhooks, /internal) prefix.
# See API_REFERENCE.md. Note: server/.env.example's PORT is 5001 locally
# (5000 conflicts with macOS AirPlay Receiver) — adjust if your backend runs
# on a different port.
VITE_API_URL=http://localhost:5000
